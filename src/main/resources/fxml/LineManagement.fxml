<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.anilink.controller.LineManagementController"
      alignment="CENTER"
      spacing="20"
      prefWidth="1000"
      prefHeight="650">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>
    <Label text="Line Management"/>
    <TableView fx:id="lineTable" prefWidth="850" prefHeight="400" maxWidth="850">
        <columns>
            <TableColumn fx:id="lineIdColumn" text="Line ID" prefWidth="150"/>
            <TableColumn fx:id="lineNameColumn" text="Line Name" prefWidth="200"/>
            <TableColumn fx:id="locationAColumn" text="Location A" prefWidth="220"/>
            <TableColumn fx:id="locationBColumn" text="Location B" prefWidth="220"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="addButton" text="Add" onAction="#handleAdd" prefWidth="150"/>
        <Button fx:id="editButton" text="Edit" onAction="#handleEdit" prefWidth="150"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" prefWidth="150"/>
    </HBox>
</VBox>