<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.edu.dlsu.anilink.controller.MyReservationsController">
    <stylesheets><URL value="@../css/main.css" /></stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #0d5c36; -fx-padding: 10 25;" styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true"><image><Image url="@../images/nologotitle.png" /></image></ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="passengerNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Passenger" />
            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px;" text="👤" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" styleClass="sidebar-white">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="20.0" /></padding>
            <Button onAction="#handleHome" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Home" />
            <Button onAction="#handleReservations" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Reservations" />
            <Button onAction="#handleTripHistory" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="My Reservations" />
            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;" styleClass="sidebar-btn" text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F8FAFC;">
            <padding><Insets bottom="30.0" left="40.0" right="40.0" top="25.0" /></padding>

            <VBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0d5c36;" styleClass="section-title" text="Trip History &amp; Reservations" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="View your past shuttle trips, pending reservations, and waitlist status" />
            </VBox>

            <VBox maxWidth="850.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);" styleClass="dashboard-card" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                <TableView fx:id="reservationTable" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="reservationCodeColumn" prefWidth="150.0" text="Reservation Code" />
                        <TableColumn fx:id="routeColumn" prefWidth="250.0" text="Route" />
                        <TableColumn fx:id="dateColumn" prefWidth="130.0" text="Date" />
                        <TableColumn fx:id="departureColumn" prefWidth="130.0" text="Departure" />
                        <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Status" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>