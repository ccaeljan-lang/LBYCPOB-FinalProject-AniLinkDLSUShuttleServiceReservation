<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.anilink.controller.PassengerDashboardController">

    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="60.0"
              spacing="20.0"
              style="-fx-background-color: #0d5c36; -fx-padding: 10 25;"
              styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true">
                <image>
                    <Image url="@../images/nologotitle.png" />
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="passengerNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Juan Dela Cruz" />
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 18px;" text="👤" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0"
              spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;"
              styleClass="sidebar-white">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <Button onAction="#handleHome" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="Home" />
            <Button onAction="#handleReservations" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Reservations" />
            <Button onAction="#handleBookSelectedTrip" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="My Reservations" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutButton"
                    onAction="#handleLogout"
                    prefHeight="40.0"
                    prefWidth="190.0"
                    style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;"
                    styleClass="sidebar-btn"
                    text="Logout" />
        </VBox>
    </left>
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>

            <VBox spacing="10.0">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" styleClass="section-title" text="Upcoming Reservation" />

                <HBox alignment="CENTER_LEFT"
                      spacing="20.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 16px 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);"
                      styleClass="dashboard-card">
                    <VBox alignment="CENTER" style="-fx-background-color: #0d5c36; -fx-background-radius: 50; -fx-min-width: 46; -fx-min-height: 46; -fx-max-width: 46; -fx-max-height: 46;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 20px;" text="🚌" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" minWidth="200.0" spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" text="ROUTE" />
                        <Label fx:id="currentTrip" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0F172A;" text="Laguna Campus → Manila Campus" />
                    </VBox>

                    <VBox alignment="CENTER" minWidth="90.0" spacing="2.0">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="DEPARTURE" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #334155;" text="8:00 AM" />
                    </VBox>

                    <VBox alignment="CENTER" minWidth="70.0" spacing="2.0">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="TRIP" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #334155;" text="Trip B" />
                    </VBox>

                    <VBox alignment="CENTER" minWidth="60.0" spacing="2.0">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="SEAT" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #0d5c36;" text="7" />
                    </VBox>

                    <VBox alignment="CENTER" minWidth="100.0" spacing="2.0">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;" text="STATUS" />
                        <Label fx:id="currentStatus"
                               style="-fx-background-color: #DCFCE7; -fx-text-fill: #15803D; -fx-background-radius: 12px; -fx-padding: 3 12; -fx-font-size: 11px; -fx-font-weight: bold;"
                               styleClass="status-badge, status-ongoing"
                               text="Confirmed" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" styleClass="section-title" text="Available Departure Schedules" />

                <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #F1F5F9; -fx-background-radius: 10px 10px 0 0; -fx-padding: 12 20;" styleClass="table-header">
                        <Label prefWidth="250.0" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="ROUTE" />
                        <Label alignment="CENTER" prefWidth="140.0" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="DEPARTURE TIME" />
                        <Label alignment="CENTER" prefWidth="140.0" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="AVAILABLE SEATS" />
                        <Label alignment="CENTER" prefWidth="120.0" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="ACTION" />
                    </HBox>

                    <ListView fx:id="tripsListView" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="WL - Waitlist  |  Seats are updated in real-time." />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="bookTripButton"
                            onAction="#handleBookSelectedTrip"
                            prefHeight="36.0"
                            prefWidth="140.0"
                            style="-fx-background-color: #0d5c36; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;"
                            text="Book Selected"
                            visible="false"
                            managed="false" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>