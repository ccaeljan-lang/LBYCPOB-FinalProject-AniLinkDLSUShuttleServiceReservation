<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.anilink.controller.QRCodeController">

    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="60.0"
              spacing="20.0"
              style="-fx-background-color: #0d5c36; -fx-padding: 10 25;"
              styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true">
                <image>
                    <Image url="@../images/nologotitle.png" />
                </image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Passenger" />
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 18px;" text="👤" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0"
              spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;"
              styleClass="sidebar-white">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <Button onAction="#handleHome" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Home" />
            <Button onAction="#handleReservations" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="Reservations" />
            <Button onAction="#handleTripHistory" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Trip History" />
            <Button onAction="#handleProfile" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Profile" />

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleLogout"
                    prefHeight="40.0"
                    prefWidth="190.0"
                    style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;"
                    styleClass="sidebar-btn"
                    text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>

            <VBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" styleClass="section-title" text="Digital Boarding Pass" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Present this QR code to the driver upon shuttle boarding" />
            </VBox>

            <VBox alignment="CENTER"
                  maxWidth="480.0"
                  spacing="20.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 4);"
                  styleClass="dashboard-card">
                <padding>
                    <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
                </padding>

                <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #0F172A;" text="AniLink Reservation QR" />

                <VBox alignment="CENTER" style="-fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 15px; -fx-background-color: #FFFFFF;">
                    <ImageView fx:id="qrCode" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" />
                </VBox>

                <VBox prefWidth="380.0"
                      spacing="8.0"
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 16px;">
                    <Label fx:id="reservationCode" style="-fx-font-family: monospace; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Reservation Code: --" />
                    <Label fx:id="passengerName" style="-fx-font-size: 13px; -fx-text-fill: #334155;" text="Passenger: --" />
                    <Label fx:id="route" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0d5c36;" text="Route: --" />
                    <Label fx:id="departureTime" style="-fx-font-size: 13px; -fx-text-fill: #334155;" text="Departure: --" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #334155;" text="Status:" />
                        <Label fx:id="status" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #004d26;" styleClass="status-badge, status-scheduled" text="SCHEDULED" />
                    </HBox>
                </VBox>

                <Button fx:id="back"
                        onAction="#handleBack"
                        prefHeight="40.0"
                        prefWidth="380.0"
                        style="-fx-background-color: #0d5c36; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;"
                        styleClass="primary-button"
                        text="Back to Reservations" />
            </VBox>
        </VBox>
    </center>
</BorderPane>