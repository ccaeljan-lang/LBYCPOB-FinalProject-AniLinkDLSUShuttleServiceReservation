<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.anilink.controller.QRCodeController"
      alignment="CENTER"
      spacing="15"
      prefWidth="900"
      prefHeight="650">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>
    <Label text="AniLink Reservation QR Code"/>
    <ImageView fx:id="qrCode" fitWidth="250" fitHeight="250" preserveRatio="true"/>
    <Label fx:id="reservationCode" text="Reservation Code: --"/>
    <Label fx:id="passengerName" text="Passenger: --"/>
    <Label fx:id="route" text="Route: --"/>
    <Label fx:id="departureTime" text="Departure: --"/>
    <Label fx:id="status" text="Status: --"/>
    <Button fx:id="back" text="Back" onAction="#handleBack" prefWidth="200"/>
</VBox>