<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.anilink.controller.QRScannerController">

    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="60.0"
              spacing="20.0"
              style="-fx-background-color: #0d5c36; -fx-padding: 10 25;"
              styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true">
                <image>
                    <Image url="@../images/nologotitle.png" />
                </image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="driverNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Driver" />
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 18px;" text="🚌" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0"
              spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;"
              styleClass="sidebar-white">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <Button onAction="#handleDashboard" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Dashboard" />
            <Button onAction="#handleTripDetails" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Trip Details" />
            <Button onAction="#handleScanQR" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="Scan QR Code" />

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleLogout"
                    prefHeight="40.0"
                    prefWidth="190.0"
                    style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;"
                    styleClass="sidebar-btn"
                    text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>

            <VBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" styleClass="section-title" text="QR Scanner" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Scan passenger boarding passes to verify reservations" />
            </VBox>

            <VBox alignment="CENTER"
                  maxWidth="500.0"
                  spacing="25.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 4);"
                  styleClass="dashboard-card">
                <padding>
                    <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
                </padding>

                <VBox alignment="CENTER"
                      prefHeight="260.0"
                      prefWidth="260.0"
                      style="-fx-border-color: #CBD5E1; -fx-border-width: 2px; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-background-color: #F1F5F9; -fx-border-style: dashed;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #94A3B8; -fx-font-size: 14px;" text="[ Camera Feed Placeholder ]" />
                </VBox>

                <HBox alignment="CENTER"
                      prefWidth="380.0"
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 16px;">
                    <Label fx:id="scanResultLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Awaiting scan..." />
                </HBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="simulateScanButton"
                            onAction="#handleSimulateScan"
                            prefHeight="40.0"
                            prefWidth="160.0"
                            style="-fx-background-color: #0d5c36; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;"
                            styleClass="primary-button"
                            text="Simulate Scan" />
                    <Button fx:id="backButton"
                            onAction="#handleBack"
                            prefHeight="40.0"
                            prefWidth="160.0"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;"
                            styleClass="secondary-button"
                            text="Cancel" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>