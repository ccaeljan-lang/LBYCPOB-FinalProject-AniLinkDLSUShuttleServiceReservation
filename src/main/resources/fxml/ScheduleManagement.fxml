<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.anilink.controller.ScheduleManagementController"
      alignment="CENTER"
      spacing="15"
      prefWidth="1000"
      prefHeight="650">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>
    <Label text="Schedule Management"/>
    <TextField fx:id="scheduleIdField" promptText="Schedule ID" prefWidth="400" maxWidth="400"/>
    <ComboBox fx:id="routeComboBox" promptText="Select Route" prefWidth="400" maxWidth="400"/>
    <TextField fx:id="departureTimeField" promptText="Departure Time (HH:mm)" prefWidth="400" maxWidth="400"/>
    <TextField fx:id="capacityField" promptText="Capacity" prefWidth="400" maxWidth="400"/>
    <HBox alignment="CENTER" spacing="15">
        <Button text="Add" onAction="#handleAddSchedule" prefWidth="150"/>
        <Button text="Delete" onAction="#handleDeleteSchedule" prefWidth="150"/>
    </HBox>
    <ListView fx:id="scheduleListView" prefWidth="600" prefHeight="250" maxWidth="600"/>
</VBox>