<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.edu.dlsu.anilink.controller.TripDetailsController">
    <stylesheets><URL value="@../css/main.css" /></stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #0d5c36; -fx-padding: 10 25;" styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true"><image><Image url="@../images/nologotitle.png" /></image></ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="driverNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Driver" />
            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px;" text="🚌" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" styleClass="sidebar-white">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="20.0" /></padding>
            <Button onAction="#handleDashboard" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Dashboard" />
            <Button onAction="#handleTripDetails" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="Trip Details" />
            <Button onAction="#handleScanQR" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Scan QR Code" />
            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;" styleClass="sidebar-btn" text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: #F8FAFC;">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

            <VBox alignment="CENTER" spacing="20.0" maxWidth="550.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 4);">
                <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d5c36;" text="Current Trip Details" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Information about your currently assigned route" />
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-pref-width: 80px;" text="Trip ID:" />
                        <Label fx:id="tripIdLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0d5c36;" text="--" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-pref-width: 80px;" text="Route:" />
                        <Label fx:id="routeLabel" style="-fx-font-size: 15px; -fx-text-fill: #0d5c36; -fx-font-weight: bold;" text="No active trip" wrapText="true" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-pref-width: 80px;" text="Departure:" />
                        <Label fx:id="scheduleLabel" style="-fx-font-size: 15px; -fx-text-fill: #0d5c36;" text="--" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-pref-width: 80px;" text="Capacity:" />
                        <Label fx:id="capacityLabel" style="-fx-font-size: 15px; -fx-text-fill: #0d5c36;" text="0 / 0" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-pref-width: 80px;" text="Status:" />
                        <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 12; -fx-background-color: #E2E8F0; -fx-text-fill: #475569;" text="N/A" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="backButton" onAction="#handleDashboard" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="Back" />
                    <Button fx:id="viewPassengersButton" onAction="#handleViewPassengers" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #0d5c36; -fx-text-fill: #FFFFFF; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;" text="View Passengers" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>