<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.anilink.controller.TripDetailsController"
      alignment="CENTER"
      spacing="20"
      prefWidth="1000"
      prefHeight="650">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <Label text="Trip Details" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <VBox alignment="CENTER_LEFT" spacing="10" maxWidth="350">
        <Label fx:id="tripIdLabel" text="Trip ID: --"/>
        <Label fx:id="routeLabel" text="Route: --"/>
        <Label fx:id="scheduleLabel" text="Schedule: --"/>
        <Label fx:id="capacityLabel" text="Capacity: 0/0"/>
        <Label fx:id="statusLabel" text="Status: SCHEDULED"/>
    </VBox>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="viewPassengersButton" text="View Passengers" onAction="#handleViewPassengers" prefWidth="180"/>
        <Button fx:id="backButton" text="Back" onAction="#handleBack" prefWidth="180"/>
    </HBox>
</VBox>