<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.anilink.controller.TripManagementController">

    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="60.0"
              spacing="20.0"
              style="-fx-background-color: #0d5c36; -fx-padding: 10 25;"
              styleClass="top-nav">
            <ImageView fitHeight="28.0" preserveRatio="true">
                <image>
                    <Image url="@../images/nologotitle.png" />
                </image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" style="-fx-text-fill: #F8FAFC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Welcome, Admin" />
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 18px;" text="⚙️" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0"
              spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;"
              styleClass="sidebar-white">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <Button onAction="#handleDashboard" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Dashboard" />
            <Button onAction="#handleRouteManagement" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Route Management" />
            <Button onAction="#handleScheduleManagement" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn" text="Schedule Management" />
            <Button onAction="#handleTripManagement" prefHeight="40.0" prefWidth="190.0" styleClass="sidebar-btn, sidebar-btn-active" text="Trip Management" />

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleLogout"
                    prefHeight="40.0"
                    prefWidth="190.0"
                    style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-cursor: hand;"
                    styleClass="sidebar-btn"
                    text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox spacing="25.0" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <VBox spacing="5.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Trip Management" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Create and manage active trips across all routes" />
            </VBox>

            <VBox spacing="20.0" VBox.vgrow="ALWAYS">

                <VBox spacing="15.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-padding: 25;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Create New Trip" />

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Route" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="routeComboBox" onAction="#handleRouteSelection" promptText="Select Route" prefWidth="200" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Departure Schedule" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="scheduleComboBox" promptText="Select Schedule" prefWidth="200" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Assign Driver" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="driverComboBox" promptText="Select Driver" prefWidth="200" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Capacity" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
                            <TextField fx:id="capacityField" promptText="e.g. 40" prefWidth="80" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Initial Status" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="statusComboBox" promptText="Status" prefWidth="130" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        </VBox>

                        <VBox alignment="BOTTOM_CENTER" prefHeight="45.0">
                            <Button onAction="#handleAddTrip" text="Create Trip" prefHeight="30" prefWidth="110" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="15.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-padding: 25;">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Existing Trips" />
                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Re-assign Driver:" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                        <ComboBox fx:id="updateDriverComboBox" promptText="Select Driver" prefWidth="160" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button onAction="#handleAssignDriver" text="Assign Driver" prefHeight="30" style="-fx-background-color: #0d5c36; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

                        <Label text="Status:" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                        <ComboBox fx:id="updateStatusComboBox" promptText="Select Status" prefWidth="140" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button onAction="#handleUpdateStatus" text="Update Status" prefHeight="30" style="-fx-background-color: #0d5c36; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

                        <Button onAction="#handleDeleteTrip" text="Delete Selected" prefHeight="30" style="-fx-background-color: #FFFFFF; -fx-text-fill: #DC2626; -fx-border-color: #DC2626; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="tripListView" VBox.vgrow="ALWAYS" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-background-radius: 6px;"/>
                </VBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>