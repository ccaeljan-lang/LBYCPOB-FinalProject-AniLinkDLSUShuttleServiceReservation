<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.anilink.controller.TripManagementController"
      alignment="CENTER"
      spacing="15"
      prefWidth="1000"
      prefHeight="700">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>
    <Label text="Trip Management"/>
    <TextField fx:id="tripIdField" promptText="Trip ID" prefWidth="400" maxWidth="400"/>
    <ComboBox fx:id="routeComboBox" promptText="Select Route" prefWidth="400" maxWidth="400"/>
    <ComboBox fx:id="scheduleComboBox" promptText="Select Schedule" prefWidth="400" maxWidth="400"/>
    <TextField fx:id="capacityField" promptText="Capacity" prefWidth="400" maxWidth="400"/>
    <ComboBox fx:id="statusComboBox" promptText="Select Status" prefWidth="400" maxWidth="400"/>
    <HBox alignment="CENTER" spacing="15">
        <Button text="Create Trip" onAction="#handleAddTrip" prefWidth="150"/>
        <Button text="Update Status" onAction="#handleUpdateStatus" prefWidth="150"/>
        <Button text="Delete" onAction="#handleDeleteTrip" prefWidth="150"/>
    </HBox>
    <ListView fx:id="tripListView" prefWidth="700" prefHeight="250" maxWidth="700"/>
</VBox>